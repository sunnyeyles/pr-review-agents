{
  "name": "pr-review-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22 <26",
    "pnpm": ">=10"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "eval": "vitest run --config evals/vitest.eval.config.ts",
    "seed-prompts": "node scripts/seed-prompts.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "esbuild": "^0.28.1",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
